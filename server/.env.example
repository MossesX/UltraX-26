# Copy to .env and fill in.
DOMAIN=calls.example.com          # DNS A record → this machine; Caddy fetches the certificate automatically
PUBLIC_IP=203.0.113.10            # the machine's public IPv4 (for coturn --external-ip)
PEERJS_KEY=peerjs                 # any string; must match "Signaling key" in the app
TURN_USER=ultrax
TURN_PASSWORD=change-me-to-something-long
